import { scenario, test } from "../kit.ts";
import * as steps from "../steps/index.ts";

/** Signs in. The smallest scenario: a check that the setup works. */
test(
  "login",
  scenario({
    require: ["APP_USERNAME", "APP_PASSWORD"],
    steps: [steps.login({ note: "Sign in" }), steps.hold({ ms: 1500 })],
  }),
);
