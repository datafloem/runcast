# Copy to .env.local (gitignored) and fill in. Never commit real passwords.

# Mode: test (default, headless), rehearsal (video pace, headless), video (recorded).
# REC_MODE=test

# Where the app runs.
# APP_BASE_URL={{BASE_URL}}

# Account used by the login step.
APP_USERNAME=
APP_PASSWORD=

# Start / stop the recording at a step (number or id).
# REC_FROM=
# REC_TO=

# Video: captions on (1) / off (0) when rendering; overrides the scenario.
# REC_CAPTIONS=
# Video format, overrides the scenario: landscape, vertical (9:16 page, mobile
# layout), vertical-crop or vertical-fit (9:16 video of the desktop page).
# REC_FORMAT=
# Ignore the narration files (warnings and render).
# REC_NARRATION=0
# Video recording pace: fast (pauses and cursor moves recorded short, the
# render restores their pace) or natural (the viewer's pace, for apps that
# react differently to a fast cursor).
# REC_RECORD_PACE=fast
# Shorten loading waits to fit the narration when rendering (1) or keep real
# time (0); overrides the scenario's compressWaits.
# REC_COMPRESS_WAITS=1
# How long the last frame stays (ms), cursor rest before clicks (ms).
# REC_END_HOLD_MS=2000
# REC_AIM_MS=400
# How video records: tab (a headless Chrome tab; the computer stays free) or
# screen (a visible window recorded with ffmpeg, only for real OS dialogs).
# REC_CAPTURE=tab
# Page size in CSS pixels, the same in test, rehearsal and video (format
# vertical: 540x960); REC_PAGE_WIDTH instead gives that width at 16:9. With
# screen capture, tests take the newest landscape video's page size.
# REC_PAGE_SIZE=1440x810
# Tab capture: video pixels per CSS pixel (2 = 2880x1620 for zooming in).
# REC_SCALE=2
# The app's own sound in the video (1) or not (0); overrides the scenario's appAudio.
# REC_APP_AUDIO=
# Output frame rate.
# REC_VIDEO_FPS=30
# Screen capture only: which screen ffmpeg captures (index: macOS, Windows ddagrab).
# REC_SCREEN=
# Screen capture on Windows: capture method (ddagrab or gdigrab; empty = try ddagrab first).
# REC_WIN_GRABBER=
# Screen capture: moves the recorded area by x,y screen pixels if the page looks shifted.
# REC_CAPTURE_OFFSET=0,0
# Browser: chrome (Google Chrome, default) or chromium (Playwright's; ARM Linux).
# REC_CHANNEL=chrome
# Screen capture on Linux without a screen: page area of the Xvfb display the
# kit starts (CSS pixels), and its scale (2 = Retina-sharp, four times the pixels).
# REC_XVFB_SIZE=1920x1080
# REC_XVFB_SCALE=1

# ElevenLabs voice-over (node tests/recording/.kit/cli.ts narration generate). Never paste the key in a chat.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
