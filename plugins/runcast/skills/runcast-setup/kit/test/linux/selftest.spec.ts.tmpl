// The Linux self-test's scenario (run.sh copies it into the sample project):
// the template's login step with every video option on.
import { scenario, test } from "../kit.ts";
import * as steps from "../steps/index.ts";

test(
  "selftest",
  scenario({
    require: ["APP_USERNAME", "APP_PASSWORD"],
    captions: true,
    blur: ['input[name="username"]'],
    intro: { title: "Runcast", subtitle: "Linux self-test" },
    outro: { title: "Done", subtitle: "Xvfb, x11grab, ffmpeg" },
    steps: [steps.login({ note: "Sign in" }), steps.hold({ ms: 2000, note: "Home" })],
  }),
);
